# ===== טכנוטיפים – משתני סביבה (ללא סודות) =====
# ערכי Firebase Web App ציבוריים מטבעם (Project settings > General > Your apps).
# ההגנה האמיתית היא ב-firestore.rules ו-storage.rules.
# ב-Vercel: Project > Settings > Environment Variables. מקומית: העתיקו ל-.env והריצו `npm run config`.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# כתובת האתר הקנונית (ללא / בסוף). אם ריק – נגזרת מהבקשה.
SITE_URL=https://technotips.example.com

# כתובות נקיות /tips/{slug} (דורש Vercel rewrites). מקומית: false.
PRETTY_URLS=true

# ===== לסקריפטים בצד שרת בלבד (scripts/) – לעולם לא בדפדפן ולא ב-Git =====
# נתיב לקובץ Service Account שהורד מ-Firebase Console.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
