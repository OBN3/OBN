rules_version = '2';

// טכנוטיפים – Storage Security Rules
// קריאה ציבורית למדיה של טיפים; העלאה ומחיקה – למנהל בלבד, תמונות בלבד, עד 10MB.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    match /tips/{tipId}/{kind}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && kind in ['poster', 'gallery']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && fileName.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
